@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var signedIn = User.Identity?.IsAuthenticated == true;
    string Active(string name) => controller == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0 viewport-fit=cover" />
    <meta name="theme-color" content="#0F6FB5" />
    <title>@ViewData["Title"] - CommuteAlert</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CommuteAlert.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>
    <div class="ca-shell">
        <header class="ca-topbar">
            <a class="ca-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bell-fill"></i> Commute Alert
            </a>
            <div class="ca-topright">
                @if (signedIn)
                {
                    <form asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="ca-icon-btn" aria-label="Log out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a class="ca-toplink" asp-area="Identity" asp-page="/Account/Login">Log in</a>
                }
            </div>
        </header>

        <main class="ca-main">
            @RenderBody()
        </main>

        @if (signedIn)
        {
            <nav class="ca-tabbar">
                <a class="ca-tab @Active("Home")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i><span>Home</span>
                </a>
                <a class="ca-tab @Active("Watches")" asp-controller="Watches" asp-action="Index">
                    <i class="bi bi-eye"></i><span>Watches</span>
                </a>
                <a class="ca-tab @Active("Alerts")" asp-controller="Alerts" asp-action="Index">
                    <i class="bi bi-clock-history"></i><span>History</span>
                </a>
                <a class="ca-tab @Active("Settings")" asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-gear"></i><span>Settings</span>
                </a>
            </nav>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
