@model List<CommuteAlert.Web.Models.Watch>
@{
    ViewData["Title"] = "My watches";
}

<h1>My watches</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}

<p><a asp-action="Search" class="btn btn-primary">New watch</a></p>

@if (Model.Count == 0)
{
    <p>You have no watches yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Station</th>
                <th>Watching</th>
                <th>Days</th>
                <th>Time</th>
                <th>Delay limit</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in Model)
            {
                <tr>
                    <td>@w.SiteName</td>
                    <td>@w.TargetName</td>
                    <td>@w.Days</td>
                    <td>@w.StartTime.ToString("HH:mm") – @w.EndTime.ToString("HH:mm")</td>
                    <td>@w.DelayThresholdMinutes min</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@w.Id" method="post"
                              onsubmit="return confirm('Delete this watch?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}