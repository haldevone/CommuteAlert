@using CommuteAlert.Web.ViewModels
@model WatchSearchViewModel
@{
    ViewData["Title"] = "Find station";
}

<h1>Find a station</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}

<form asp-action="Search" method="get" class="mb-3">
    <div class="input-group">
        <input name="query" value="@Model.Query" class="form-control" placeholder="Station name, for example Södertälje" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model.Error != null)
{
    <div class="alert alert-warning">@Model.Error</div>
}
else if (Model.Query != null && Model.Results.Count == 0)
{
    <p>No stations found.</p>
}

<ul class="list-group">
    @foreach (var site in Model.Results)
    {
        <li class="list-group-item">
            <a asp-action="Create" asp-route-siteId="@site.Id">@site.Name</a>
        </li>
    }
</ul>