@using CommuteAlert.Web.ViewModels
@model WebhookViewModel
@{
	ViewData["Title"] = "Settings";
}

<h1>Discord webhook</h1>

@if (TempData["Message"] is string message)
{
	<div class="alert alert-info">@message</div>
}

<p>@(Model.HasWebhook ? "A webhook is saved. Enter a new address to replace it." : "No webhook saved yet.")</p>

<form asp-action="Save" method="post">
    <div class="mb-3">
        <label asp-for="Url" class="form-label">Webhook address</label>
        <input asp-for="Url" type="password" autocomplete="off" class="form-control" />
        <span asp-validation-for="Url" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

@if (Model.HasWebhook)
{
    <form asp-action="SendTest" method="post" class="mt-3">
        <button type="submit" class="btn btn-secondary">Send test message</button>
    </form>
}