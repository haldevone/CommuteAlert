@using CommuteAlert.Web.ViewModels
@model WebhookViewModel
@inject IAuthorizationService Authorization
@using Microsoft.AspNetCore.Authorization
@{
    ViewData["Title"] = "Settings";
}

<h1>Settings</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-info">@message</div>
}

<div class="ca-card">
    <i class="bi bi-discord ca-card-icon"></i>
    <div class="ca-card-title">Discord webhook</div>
    <p class="ca-card-text">
        @if (Model.HasWebhook)
        {
            <span class="ca-badge ca-badge-green">Connected</span>
        }
        else
        {
            <span class="ca-badge ca-badge-grey">Not connected</span>
        }
    </p>

    <form asp-action="Save" method="post">
        <div class="mb-3">
            <label asp-for="Url" class="form-label">@(Model.HasWebhook ? "Replace webhook address" : "Webhook address")</label>
            <input asp-for="Url" type="password" autocomplete="off" class="form-control" />
            <span asp-validation-for="Url" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>

    @if (Model.HasWebhook)
    {
        <form asp-action="SendTest" method="post" class="mt-2">
            <button type="submit" class="btn btn-outline-primary">Send test message</button>
        </form>
    }
</div>

<div class="ca-card">
    <div class="ca-card-title">How to get a webhook</div>
    <p class="ca-card-text mb-0">In Discord, open your channel's settings, go to Integrations, then Webhooks, create a new webhook and copy its address.</p>
</div>

<div class="ca-card">
    <div class="ca-card-title">Account</div>
    <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-outline-primary mt-2">Change password</a>
</div>

@if ((await Authorization.AuthorizeAsync(User, "Admin")).Succeeded)
{
    <div class="ca-card">
        <div class="ca-card-title">Admin</div>
        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary mt-2">Manage users</a>
    </div>
}