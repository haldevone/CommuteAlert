@using CommuteAlert.Web.ViewModels
@model List<AlertHistoryItem>
@{
    ViewData["Title"] = "History";
}

<h1>Alert history</h1>
<p class="ca-muted">Your 50 latest alerts. "Not sent" means no webhook is saved or Discord could not be reached. The app stops retrying after 30 minutes.</p>

@if (Model.Count == 0)
{
    <div class="ca-card ca-empty">
        <i class="bi bi-bell-slash"></i>
        <p class="mb-0">No alerts yet.</p>
    </div>
}
else
{
    foreach (var item in Model)
    {
        <partial name="_AlertCard" model="item" />
    }
}